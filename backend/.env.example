# Live LLM mode needs credentials: either an API key here, or an `ant auth login` profile.
ANTHROPIC_API_KEY=
# live (default) = Claude Opus 5.5 makes every agent decision; rules = deterministic paths only (tests, KPI simulation)
LLM_MODE=live
# Optional overrides
# ESM_DB_PATH=./data/esm.db
# Only needed if your API key is not scoped to a workspace (Console -> Settings -> Workspaces)
ANTHROPIC_WORKSPACE_ID=
